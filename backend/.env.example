# Copy to backend/.env and adjust. Every value below has a working default —
# the app runs with no .env at all, on SQLite, with one worker.

# SQLite (default, zero setup) or PostgreSQL:
#   postgresql+psycopg://cybershield:cybershield@localhost:5432/cybershield
# A hosted `postgres://...` or `postgresql://...` URL is rewritten to the
# psycopg driver automatically, so you can paste a provider's URL as given.
DATABASE_URL=sqlite:///./cybershield.db

# Shared state for multiple uvicorn workers: WebSocket fan-out, rate-limit
# counters, detection windows, alert correlation, simulator ownership. Leave it
# empty for one worker and in-process state.
#   redis://localhost:6379/0
REDIS_URL=

# Workers. Anything above 1 needs REDIS_URL above — the app logs an error at
# boot if you scale out without it. Read by uvicorn, not by the app itself.
WEB_CONCURRENCY=1

# CHANGE THIS before the API is reachable from anything but localhost.
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=720

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=300

# Serve frontend/dist from the API when it exists, so a cloud deploy is one
# service on one origin. Set false to keep the API JSON-only behind nginx.
SERVE_FRONTEND=true

# Number of demo attack events generated on first startup. 0 disables seeding.
SEED_DEMO_EVENTS=250

# Optional. Without a key the AI assistant uses its built-in analyst templates,
# which are complete and offline — the key only upgrades them to live analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
